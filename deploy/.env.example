# Addis Tiggena production environment — copy to deploy/.env on the server and fill in.
# NODE_ENV=production is forced by the compose file: devCode and unsigned webhooks are OFF.

# ── Domains (DNS A records must point at the ECS elastic IP) ──────────────────
WEB_DOMAIN=tiggena.example.com
API_DOMAIN=api.tiggena.example.com
WEB_PUBLIC_URL=https://tiggena.example.com
API_PUBLIC_URL=https://api.tiggena.example.com

# ── Database (db service runs on the same box for now) ────────────────────────
# generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# ── Auth ──────────────────────────────────────────────────────────────────────
# generate: openssl rand -hex 32
JWT_SECRET=
JWT_ACCESS_TTL=1h
JWT_REFRESH_TTL=30d
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60

# ── SMS (console is dev-only; production needs a real provider) ───────────────
# africastalking requires AT_USERNAME + AT_API_KEY or the API refuses to boot.
SMS_PROVIDER=africastalking
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# ── Payments ──────────────────────────────────────────────────────────────────
COMMISSION_RATE=0.10
# Chapa: secret key enables real checkout + authoritative webhook verification.
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=
# Telebirr / CBEBirr webhook HMAC secrets — REQUIRED: without a secret every
# webhook for that gateway is rejected in production (fail closed).
TELEBIRR_WEBHOOK_SECRET=
CBEBIRR_WEBHOOK_SECRET=
# Never set PAYMENTS_ALLOW_UNSIGNED_WEBHOOKS here — it is ignored outside development.

# ── Telegram ──────────────────────────────────────────────────────────────────
# Same token for the bot process and the API's notification pushes.
BOT_TOKEN=
# Shared secret between bot and API — generate: openssl rand -hex 24
BOT_API_KEY=
