# Base URL of the NestJS API (apps/api)
NEXT_PUBLIC_API_URL=http://localhost:4001

# Set to 1 to show developer-only UI (e.g. "Simulate gateway confirmation" for
# payment webhooks — only works when the API runs with
# PAYMENTS_ALLOW_UNSIGNED_WEBHOOKS=true). Leave unset in production.
NEXT_PUBLIC_DEV_TOOLS=1
