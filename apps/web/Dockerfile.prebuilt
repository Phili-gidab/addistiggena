# Addis Tiggena web — runtime-only image for a HOST-PREBUILT .next bundle.
# Use when the in-Docker build can't reach fonts.googleapis.com (flaky ISP):
#   NEXT_PUBLIC_API_URL=<api url> npm run build -w apps/web
#   docker build -f apps/web/Dockerfile.prebuilt -t tiggena-web:latest apps/web
# The .next output already has the API URL baked in from the host build env.
FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY package.json ./
RUN npm install --no-audit --no-fund --omit=dev
COPY next.config.mjs ./
COPY public ./public
COPY .next ./.next
EXPOSE 4000
CMD ["npm", "run", "start"]
