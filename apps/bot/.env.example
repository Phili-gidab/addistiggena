# Get a token from @BotFather on Telegram
BOT_TOKEN=

# Addis Tiggena API base URL
API_URL=http://localhost:4001

# Shared secret for POST /auth/telegram/link|resume.
# MUST match BOT_API_KEY in apps/api/.env (the API's dev default is `dev-bot-key`).
BOT_API_KEY=dev-bot-key

# Public web app base URL, used in tracking/payment links sent to users
WEB_URL=http://localhost:4000
