# Explicit environment: 'development' enables devCode in OTP responses and the
# unsigned-webhook flag below; anything else fails closed. Set 'production' on servers.
NODE_ENV=development

# PostgreSQL (docker-compose defaults)
DATABASE_URL="postgresql://tiggena:tiggena_dev@localhost:5432/tiggena?schema=public"

# HTTP (avoid 2630-3346 — reserved by Windows/Hyper-V on some machines)
PORT=4001

# Auth
JWT_SECRET="change-me-in-production"
JWT_ACCESS_TTL="1h"
JWT_REFRESH_TTL="30d"

# OTP
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60

# SMS delivery: console | afromessage | ethiotelecom | africastalking
SMS_PROVIDER=console
# AfroMessage credentials (required when SMS_PROVIDER=afromessage).
# API key = the JWT from the AfroMessage dashboard (Goto Team -> API keys).
# Sender name + identifier id come from the dashboard's Sender Names page;
# omit both to use the account default. Callback is optional (delivery reports).
# AFRO_API_KEY=
# AFRO_SENDER_NAME=
# AFRO_IDENTIFIER_ID=
# AFRO_CALLBACK=
# Transactional SMS (job offers, status updates, escalations): on | off.
# "off" keeps the SMS credit for login OTPs only - Telegram pushes still go out.
SMS_NOTIFICATIONS=on
# Africa's Talking credentials (required when SMS_PROVIDER=africastalking)
# AT_USERNAME=
# AT_API_KEY=
# AT_SENDER_ID=

# Platform commission (fraction of gross), overridable at runtime via admin config
COMMISSION_RATE=0.10

# Public URLs (used for payment callback/return links)
API_PUBLIC_URL=http://localhost:4001
WEB_PUBLIC_URL=http://localhost:4000

# Payment gateways. Without credentials the drivers run in instruction-only dev mode.
# CHAPA_SECRET_KEY=
# Webhook signing secrets (HMAC-SHA256 of the JSON payload). REQUIRED in production —
# without a secret every webhook is rejected unless the dev flag below is on.
# CHAPA_WEBHOOK_SECRET=
# TELEBIRR_WEBHOOK_SECRET=
# CBEBIRR_WEBHOOK_SECRET=
# Dev-only: accept unsigned payment webhooks (the web app's "simulate" button). Never in prod.
PAYMENTS_ALLOW_UNSIGNED_WEBHOOKS=true

# Telegram: bot token lets the API push booking updates to linked chats;
# BOT_API_KEY is the shared secret the bot uses to call /auth/telegram/*.
# BOT_TOKEN=
# BOT_API_KEY=
